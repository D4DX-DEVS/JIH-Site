# Example configuration for jih-kerala. Copy the names you need into your own .env (local
# development) or set them as Cloudflare Worker variables/secrets (production).
# This file holds no real values. Never commit real credentials.
# (Named env.example rather than .env.example because .env* files are locked in this workspace.)

# --- Admin sign-in (required) -------------------------------------------------
# The admin email address used to sign in.
ADMIN_EMAIL=
# PBKDF2 hash of the admin password. Generate it with:  npm run admin:hash-password
# (the password itself is never stored). Production: wrangler secret put ADMIN_PASSWORD_HASH
ADMIN_PASSWORD_HASH=

# --- Public site ----------------------------------------------------------------
# Canonical origin used in canonical links, sitemap, RSS and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://jihkerala.org
# Set to "true" only on the production domain; anything else makes robots.txt block crawlers.
SITE_INDEXABLE=false
# Optional: serve media straight from an R2 custom domain instead of the app's /media route.
# Example: https://media.jihkerala.org   (leave empty to use /media)
NEXT_PUBLIC_MEDIA_BASE_URL=

# --- Migration scripts (local only) ---------------------------------------------
# WordPress site to extract from. Defaults to the staging host if unset.
WP_SOURCE_URL=https://wordpress-1683093-6756662.cloudwaysapps.com
# WordPress administrator login for `npm run migrate:extract-admin` (drafts, unlisted media,
# form entries). Read-only use; remove once the migration is finished.
WP_USERNAME=
WP_PASSWORD=

# --- Cloudflare (CLI only; used by wrangler for deploys and --remote migrations) ---
# Wrangler reads these from the environment; the API token needs D1, R2 and Workers edit rights.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# D1 and R2 are reached through the DB and MEDIA bindings in wrangler.jsonc, not through
# variables: set the production database_id there (see docs/DEPLOYMENT.md).
