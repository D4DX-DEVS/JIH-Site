{
  "name": "jih-kerala",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:build": "opennextjs-cloudflare build && node scripts/patch-worker.mjs",
    "preview": "npm run cf:build && opennextjs-cloudflare preview",
    "deploy": "echo \"Deploy requires explicit approval. See docs/DEPLOYMENT.md\" && exit 1",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "migrate:extract": "node scripts/migrate/extract.mjs",
    "migrate:extract-admin": "node --env-file=.env scripts/migrate/extract-admin.mjs",
    "migrate:crawl": "node scripts/migrate/crawl.mjs",
    "migrate:import": "tsx scripts/migrate/import.ts",
    "migrate:verify": "tsx scripts/migrate/verify.ts",
    "migrate:split-languages": "tsx scripts/migrate/split-languages.ts",
    "admin:hash-password": "tsx scripts/hash-password.ts",
    "admin:hash-env-password": "tsx scripts/hash-env-password.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.2",
    "@opennextjs/cloudflare": "^1.20.14",
    "@tiptap/core": "^3.32.1",
    "@tiptap/extension-image": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/react": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.64.0",
    "motion": "^14.7.1",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261029.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "cheerio": "^1.2.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0"
  }
}
