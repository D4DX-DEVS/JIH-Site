{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jih-kerala",
  // Wraps the OpenNext build: legacy redirects, the admin sign-in gate and 404 status codes (src/lib/edge-routing.ts).
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "jih-kerala"
    }
  ],
  // Production D1/R2 on the Cloudflare account. "remote": true makes the migration scripts
  // (getPlatformProxy) write to these instead of the local Miniflare state.
  //   npm run migrate:import -- --remote --config wrangler.production.jsonc --yes-i-have-approval
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jih",
      "database_id": "bb2802c8-0cbe-4ce4-a181-16ab743b0969",
      "migrations_dir": "drizzle/migrations",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "jih",
      "remote": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
